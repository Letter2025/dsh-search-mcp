{
  "name": "dsh-search-mcp",
  "version": "0.3.0",
  "description": "Replace dsh's built-in web search with search MCP servers (Tavily / Brave / Exa / Perplexity / DuckDuckGo / custom). The plugin's Config row is rendered by dsh's auto-generated settings page, so server lists and keys live in the profile config; when enabled the built-in DeepSeek search provider is disabled.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/provider.js && node --check lib/catalog.js && node --check lib/extract.js && node --check lib/url-policy.js && node --check lib/client.js",
    "test": "node --test"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "mcp",
    "search",
    "web_search",
    "tavily",
    "brave",
    "exa",
    "perplexity",
    "duckduckgo"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "ipaddr.js": "2.5.0",
    "undici": "6.28.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-credentials": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-launch-environment": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-web": "^0.1.7-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-credentials": "0.1.7-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-web": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  }
}